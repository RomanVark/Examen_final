<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.practicasprofesionales.controller.ApiConsumoController"
      spacing="14" styleClass="page">
    <Label text="Prueba y consumo de API REST" styleClass="page-title"/>
    <Label text="Consulta Spring Boot desde JavaFX; las solicitudes se registran para el reporte de consumo."
           styleClass="page-subtitle" wrapText="true"/>
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Servidor:"/>
        <TextField fx:id="servidorApi" HBox.hgrow="ALWAYS" promptText="http://127.0.0.1:8080"/>
    </HBox>
    <FlowPane hgap="9" vgap="9">
        <Button text="Estado API" onAction="#consultarSalud" styleClass="secondary-button"/>
        <Button text="Estudiantes" onAction="#consultarEstudiantes" styleClass="primary-button"/>
        <Button text="Empresas" onAction="#consultarEmpresas" styleClass="primary-button"/>
        <Button text="Prácticas" onAction="#consultarPracticas" styleClass="primary-button"/>
        <Button text="Reporte de consumo" onAction="#consultarConsumo" styleClass="secondary-button"/>
    </FlowPane>
    <TextArea fx:id="resultado" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>
    <Label fx:id="estado" text="Elige una consulta" styleClass="status-note" wrapText="true"/>
</VBox>
