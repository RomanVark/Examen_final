<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.1">
  <persistence-unit name="practicasPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
    <class>ni.edu.uam.practicasprofesionales.model.academico.Carrera</class>
    <class>ni.edu.uam.practicasprofesionales.model.academico.Estudiante</class>
    <class>ni.edu.uam.practicasprofesionales.model.alianzas.Empresa</class>
    <class>ni.edu.uam.practicasprofesionales.model.academico.TutorAcademico</class>
    <class>ni.edu.uam.practicasprofesionales.model.alianzas.SupervisorEmpresa</class>
    <class>ni.edu.uam.practicasprofesionales.model.alianzas.Convenio</class>
    <class>ni.edu.uam.practicasprofesionales.model.asignaciones.OfertaPractica</class>
    <class>ni.edu.uam.practicasprofesionales.model.asignaciones.Postulacion</class>
    <class>ni.edu.uam.practicasprofesionales.model.asignaciones.Practica</class>
    <class>ni.edu.uam.practicasprofesionales.model.seguimiento.Bitacora</class>
    <class>ni.edu.uam.practicasprofesionales.model.seguimiento.Evaluacion</class>
    <class>ni.edu.uam.practicasprofesionales.model.seguimiento.Documento</class>
    <properties>
      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
      <property name="hibernate.hbm2ddl.auto" value="validate"/>
      <property name="hibernate.show_sql" value="false"/>
      <property name="hibernate.format_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
